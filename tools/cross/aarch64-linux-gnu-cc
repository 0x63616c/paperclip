#!/bin/sh
# Cross C compiler and linker driver for the tablet, built on `zig cc`.
#
# The reMarkable SDK is the right toolchain for anything that links Qt, but it
# is a multi-gigabyte download and a pure-Rust binary does not need it. `zig cc`
# ships its own glibc stubs and cross-links aarch64 from a Mac with nothing
# installed but zig, which is what makes "does the device half even compile"
# answerable in seconds rather than after an SDK install.
#
# glibc 2.36, not the 2.39 the device actually has (Yocto scarthgap): linking
# against an older glibc produces a binary that runs on a newer one, and the
# reverse is exactly the "GLIBC_2.39 not found" failure that only shows up on
# the tablet. Raise this only with a reason.
#
# Not a substitute for the SDK. `platform/device`'s `vendor-engine` feature
# needs Qt 6.10.3 headers and the vendor library; see
# platform/device/native/README.md.
#
# Only ever a *linker* until WWW-68 (`ring`, for the HTTPS catalog
# transport's TLS): the first real C dependency in the device build, so this
# is the first time `cc-rs` invokes this script to *compile* rather than
# link. `cc-rs` appends its own `--target=aarch64-unknown-linux-gnu` (the
# rustc triple, four components) when it detects a clang-family compiler,
# and zig's target parser rejects that outright — it wants the three-component
# form above, not a triple with an "unknown" vendor. Left in place, the two
# `-target` flags both reach zig and the last one wins, which is the broken
# one. Strip any incoming `--target=` before ours, so ours stays the only one
# zig sees.
args=
for arg do
    case $arg in
        --target=*) continue ;;
    esac
    args="$args${args:+ }'$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")'"
done
eval "set -- $args"
exec zig cc -target aarch64-linux-gnu.2.36 "$@"
